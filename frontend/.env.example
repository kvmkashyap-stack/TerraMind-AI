# Next.js Frontend Deployment Environment Variables

# Backend API URL (Replace with your deployed backend server URL on Vercel/Render/Railway)
# Example for Production: https://your-backend-api.onrender.com/api/v1
# Example for Local Development: http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
