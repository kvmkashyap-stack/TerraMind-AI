# 🌍 TerraMind AI — Backend Environment Configuration Example

# Tavily Web Search API Key (Get key at https://tavily.com)
TAVILY_API_KEY=your-tavily-api-key-here

# Optional LLM API Keys (Groq / OpenAI / Gemini / Moonshot)
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
MOONSHOT_API_KEY=your-moonshot-api-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL_NAME=moonshot-v1-8k

# Copernicus / Sentinel Satellite Data Credentials (https://dataspace.copernicus.eu/)
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret

# Application Environment (development / production)
ENVIRONMENT=development
